# Copy to .env.local. Nothing here is required for local development.

# Canonical origin, used for metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://getpaidnyc.org

# "prelaunch" (the default) serves the holding page at /, "live" serves the
# full site. Leave this unset to keep the gate up.
# NEXT_PUBLIC_SITE_STAGE=live

# Optional section and print toggles.
# NEXT_PUBLIC_HIDE_WORKSHOP=true
# NEXT_PUBLIC_DISABLE_GRAIN=true

# Where pre-launch signups are forwarded. Set one of these. With neither set,
# /api/notify refuses the signup rather than confirming a list that does not
# exist.
#
# A provider's public signup-form action, posted like its own embed form
# (for Kit: https://app.kit.com/forms/<form id>/subscriptions). The email field
# name defaults to Kit's "email_address".
# NOTIFY_FORM_URL=
# NOTIFY_FORM_EMAIL_FIELD=email_address
#
# Or any endpoint that accepts a JSON POST of { email, source }.
# NOTIFY_WEBHOOK_URL=
