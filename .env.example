# Copy to .env.local. Nothing here is required for local development.

# Canonical origin, used for metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://getpaidnyc.org

# "live" serves the full site, "prelaunch" serves the holding page at /.
# Set NOTIFY_WEBHOOK_URL below before switching this to prelaunch.
NEXT_PUBLIC_SITE_STAGE=live

# Optional section and print toggles.
# NEXT_PUBLIC_HIDE_WORKSHOP=true
# NEXT_PUBLIC_DISABLE_GRAIN=true

# Where pre-launch signups are forwarded. Any endpoint that accepts a JSON POST
# of { email, source }. With this unset, /api/notify refuses the signup rather
# than confirming a list that does not exist.
# NOTIFY_WEBHOOK_URL=
